# Copy this file to .env and fill in real values. Never commit .env itself.

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Phase 1 - leave as-is for SQLite (default path is data/identity.db)
# DATABASE_URL=sqlite:///./data/identity.db

# Phase 3 - fill in when you start LLM integration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=INFO
